CLAUDE_PATH=C:\Users\AG\.local\bin\claude.exe
CLAUDE_MODEL=haiku
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT=300
PORT=8082
BATCH_MAX_CONCURRENT=3
BATCH_MAX_RETRIES=5
# Optional: cap thinking tokens to further reduce usage (e.g. 4000, 8000)
# MAX_THINKING_TOKENS=
# Extra Claude CLI flags. Default disables the built-in tools (Bash, Read, ...)
# so each call carries a ~150-token system prompt instead of ~23k.
# CLAUDE_EXTRA_ARGS=--tools ""
# System prompt used when a request has none (otherwise the CLI injects its own 7k-token one)
# DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
